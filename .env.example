# Optional local/worker configuration. Never commit real values.
DATABASE_URL=postgres://supermarket:supermarket@localhost:5432/supermarket
GEOCODER_USER_AGENT=sal-zol-development/0.1 (contact@example.invalid)
# Optional: override the default OpenStreetMap/Nominatim endpoint.
# LOCATION_GEOCODER_URL=https://nominatim.openstreetmap.org/search
# LOCATION_GEOCODER_PROVIDER=nominatim
# Optional server-side JSON branch feed. The response may be an array or an object
# with a stores/records/branches array of normalized branch records. A source
# is marked complete only when it also declares completeness.expectedBranchCount.
# STORE_DIRECTORY_URL=https://example.invalid/stores.json
# Optional normalized catalog snapshot published by a worker after validating a
# full retailer feed. See docs/ingestion-runbook.md; an undeclared or partial
# scope is never reported as complete.
# CATALOG_SOURCE_URL=https://example.invalid/catalog.json
# CATALOG_SOURCE_MAX_BYTES=209715200
# CATALOG_SOURCE_TIMEOUT_MS=30000
# Optional HTTP listing surfaces. The Cerberus production path may instead
# require an injected FTP/TLS downloader; credentials are never read by the UI.
# CERBERUS_LISTING_URL=https://example.invalid/cerberus-listing.html
# SHUFERSAL_LISTING_URL=https://prices.shufersal.co.il/
# SHUFERSAL_CATEGORY_ENDPOINT_URL=https://prices.shufersal.co.il/FileObject/UpdateCategory
# CERBERUS_FTP_HOST=
# CERBERUS_FTP_USER=
# CERBERUS_FTP_PASSWORD=
